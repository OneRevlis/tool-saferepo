#!/usr/bin/env bash
# vet <git-url|path> [--deep] — scan a repo WITHOUT running its code.
# All cloning and scanning happens in Docker; nothing runs on your host.
#
# vet is TRIAGE, not a clean bill of health. Static scanners cannot catch a
# novel backdoor. Always run the code in `sandbox` regardless of what vet says.
#
#   default   containerized clone + static grep + Trivy (CVEs/secrets) + GuardDog
#   --deep    also installs deps in an isolated container (--ignore-scripts),
#             re-runs GuardDog on the installed tree, and Trivy-scans node_modules
set -euo pipefail

# Pinned by digest for reproducibility (update via install.sh).
TRIVY="aquasec/trivy@sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969"
GUARDDOG="ghcr.io/datadog/guarddog@sha256:3dbc783f65f508b95222101cb2cd84d1d5f3e3675e42d6f1329bb9b8a99c8998"
NODE="node@sha256:8a34c4ab3ea2c5cd194f07e317b2a8f09461d3c8b05c4e34c8ccd56d56024c4d"

SRC="${1:?usage: vet <git-url|local-path> [--deep]}"
DEEP="${2:-}"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/vet.XXXXXX")"

if [ -d "$SRC" ]; then
  cp -R "$SRC" "$WORK/repo"
else
  # Clone INSIDE a container: a malicious repo exploiting a git-client RCE
  # during clone (e.g. CVE-2024-32002) hits the throwaway container, not host git.
  echo "### cloning in an isolated container ###"
  docker run --rm -v "$WORK":/out -w /out "$NODE" git clone --depth 1 "$SRC" repo
fi
REPO="$WORK/repo"
echo "=== vetting: $REPO ==="

echo; echo "### 1. Install hooks (code that auto-runs on install) ###"
grep -rnE '"(pre|post)(install|pack|prepare)"' \
  "$REPO"/package.json "$REPO"/*/package.json 2>/dev/null || echo "  (none in root package.json)"
[ -f "$REPO/setup.py" ] && echo "  setup.py present (runs code on 'pip install')"

echo; echo "### 2. Dangerous patterns (remote exec / obfuscation) — NOISY, triage only ###"
grep -rnE 'curl[^|]*\|[[:space:]]*(ba)?sh|wget[^|]*\|[[:space:]]*(ba)?sh|eval\(|new Function\(|base64 -d|atob\(|child_process' \
  "$REPO" --include='*.js' --include='*.ts' --include='*.mjs' --include='*.sh' --include='*.py' \
  2>/dev/null | grep -v node_modules | head -30 || echo "  (none found)"

echo; echo "### 3. Trivy — known CVEs + leaked secrets (dockerized) ###"
docker run --rm -v "$REPO":/scan:ro "$TRIVY" fs --scanners vuln,secret --severity HIGH,CRITICAL /scan

echo; echo "### 4. GuardDog — MALICIOUS dependency detection (dockerized) ###"
if [ -f "$REPO/package.json" ]; then
  docker run --rm -v "$REPO":/scan:ro "$GUARDDOG" npm verify /scan/package.json 2>&1 | tail -40
elif [ -f "$REPO/requirements.txt" ]; then
  docker run --rm -v "$REPO":/scan:ro "$GUARDDOG" pypi verify /scan/requirements.txt 2>&1 | tail -40
else
  echo "  (no package.json / requirements.txt — skipped)"
fi

if [ "$DEEP" = "--deep" ] && [ -f "$REPO/package.json" ]; then
  echo; echo "### 5. DEEP scan ###"
  echo "!! this step has NETWORK access to fetch tarballs — run it on a network you trust."
  echo "  installing deps in an isolated non-root container (--ignore-scripts)..."
  docker run --rm -v "$REPO":/repo -w /repo --user node \
    --cap-drop=ALL --security-opt=no-new-privileges "$NODE" \
    sh -c '[ -f package-lock.json ] && npm ci --ignore-scripts --no-audit --no-fund || npm install --ignore-scripts --no-audit --no-fund' \
    2>&1 | tail -5
  echo "  re-running GuardDog on the INSTALLED tree (catches malicious transitive deps)..."
  docker run --rm -v "$REPO":/scan:ro "$GUARDDOG" npm scan /scan/node_modules 2>&1 | tail -30 || echo "  (guarddog scan skipped)"
  echo "  Trivy scan of installed node_modules..."
  docker run --rm -v "$REPO":/scan:ro "$TRIVY" fs --scanners vuln --severity HIGH,CRITICAL /scan 2>&1 | tail -20
fi

echo; echo "=== done (TRIAGE only — still run it in the sandbox). Source: $REPO ==="
echo "Next:   sandbox $REPO          # network OFF by default"
