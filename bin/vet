#!/usr/bin/env bash
# vet <git-url|path> [--deep] — scan a repo WITHOUT running its code.
# All scanning happens in Docker; nothing is installed on your host.
#
#   default   static grep + Trivy (CVEs/secrets) + GuardDog (malicious packages)
#   --deep    also installs deps in an isolated container (--ignore-scripts) and
#             Trivy-scans the resulting node_modules — catches malicious code that
#             lives in dependencies, not just the repo's own source.
set -euo pipefail

SRC="${1:?usage: vet <git-url|local-path> [--deep]}"
DEEP="${2:-}"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/vet.XXXXXX")"

if [ -d "$SRC" ]; then cp -R "$SRC" "$WORK/repo"; else git clone --depth 1 "$SRC" "$WORK/repo"; fi
REPO="$WORK/repo"
echo "=== vetting: $REPO ==="

echo; echo "### 1. Install hooks (code that auto-runs on install) ###"
grep -rnE '"(pre|post)(install|pack|prepare)"' \
  "$REPO"/package.json "$REPO"/*/package.json 2>/dev/null || echo "  (none in root package.json)"
[ -f "$REPO/setup.py" ] && echo "  setup.py present (runs code on 'pip install')"

echo; echo "### 2. Dangerous patterns (remote exec / obfuscation) ###"
grep -rnE 'curl[^|]*\|[[:space:]]*(ba)?sh|wget[^|]*\|[[:space:]]*(ba)?sh|eval\(|new Function\(|base64 -d|atob\(|child_process' \
  "$REPO" --include='*.js' --include='*.ts' --include='*.mjs' --include='*.sh' --include='*.py' \
  2>/dev/null | grep -v node_modules | head -30 || echo "  (none found)"

echo; echo "### 3. Trivy — known CVEs + leaked secrets (dockerized) ###"
docker run --rm -v "$REPO":/scan:ro aquasec/trivy:latest fs --scanners vuln,secret --severity HIGH,CRITICAL /scan

echo; echo "### 4. GuardDog — MALICIOUS dependency detection (dockerized) ###"
if [ -f "$REPO/package.json" ]; then
  docker run --rm -v "$REPO":/scan:ro ghcr.io/datadog/guarddog:latest npm verify /scan/package.json 2>&1 | tail -40
elif [ -f "$REPO/requirements.txt" ]; then
  docker run --rm -v "$REPO":/scan:ro ghcr.io/datadog/guarddog:latest pypi verify /scan/requirements.txt 2>&1 | tail -40
else
  echo "  (no package.json / requirements.txt — skipped)"
fi

if [ "$DEEP" = "--deep" ] && [ -f "$REPO/package.json" ]; then
  echo; echo "### 5. DEEP: install deps in isolated container + scan the installed tree ###"
  echo "  installing with --ignore-scripts (no install hooks run)..."
  docker run --rm -v "$REPO":/repo -w /repo \
    --cap-drop=ALL --security-opt=no-new-privileges node:22-bookworm \
    sh -c '[ -f package-lock.json ] && npm ci --ignore-scripts --no-audit --no-fund || npm install --ignore-scripts --no-audit --no-fund' \
    2>&1 | tail -5
  echo "  scanning installed node_modules for CVEs..."
  docker run --rm -v "$REPO":/scan:ro aquasec/trivy:latest fs --scanners vuln --severity HIGH,CRITICAL /scan 2>&1 | tail -20
fi

echo; echo "=== done. Source is at: $REPO ==="
echo "If it looks clean, run it isolated:   sandbox $REPO --no-net"
