#!/usr/bin/env bash
# vet <git-url|path> [--deep] — scan a repo WITHOUT running its code, then print
# a clear verdict: CLEAN / REVIEW / DANGER. All work happens in Docker.
#
# A CLEAN verdict means "no known red flags" — NOT a guarantee. Scanners cannot
# catch a novel hand-written backdoor. Use it as a strong filter, not proof.
#
#   default   containerized clone + install-hooks + Trivy (CVEs/secrets) + GuardDog
#   --deep    also installs deps isolated (--ignore-scripts) and re-scans the tree
set -euo pipefail

TRIVY="aquasec/trivy@sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969"
GUARDDOG="ghcr.io/datadog/guarddog@sha256:3dbc783f65f508b95222101cb2cd84d1d5f3e3675e42d6f1329bb9b8a99c8998"
NODE="node@sha256:8a34c4ab3ea2c5cd194f07e317b2a8f09461d3c8b05c4e34c8ccd56d56024c4d"

SRC="${1:?usage: vet <git-url|local-path> [--deep]}"
DEEP="${2:-}"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/vet.XXXXXX")"
OUT="$WORK/out"; mkdir -p "$OUT"

if [ -d "$SRC" ]; then
  cp -R "$SRC" "$WORK/repo"
else
  echo "### cloning in an isolated container ###"
  docker run --rm -v "$WORK":/out -w /out "$NODE" git clone --depth 1 "$SRC" repo
fi
REPO="$WORK/repo"
echo "=== vetting: $REPO ==="

# --- 1. install hooks ---
HOOKS="$(grep -rhnE '"(pre|post)(install|pack|prepare)"' "$REPO"/package.json "$REPO"/*/package.json 2>/dev/null || true)"
[ -f "$REPO/setup.py" ] && HOOKS="$HOOKS"$'\n'"setup.py present (runs code on pip install)"
echo; echo "### 1. Install hooks ###"; echo "${HOOKS:-  (none)}"

# --- 2. patterns: split GENUINELY DANGEROUS (pipe-to-shell) from NOISY (eval/etc) ---
PIPE_EXEC="$(grep -rnE '(curl|wget)[^|]*\|[[:space:]]*(ba)?sh' \
  "$REPO" --include='*.js' --include='*.ts' --include='*.mjs' --include='*.sh' --include='*.py' --include='*.json' 2>/dev/null | grep -v node_modules | head -20 || true)"
NOISY="$(grep -rnE 'eval\(|new Function\(|base64 -d|atob\(' \
  "$REPO" --include='*.js' --include='*.ts' --include='*.mjs' --include='*.sh' --include='*.py' 2>/dev/null | grep -v node_modules | head -20 || true)"
echo; echo "### 2. Patterns ###"
echo "  DANGEROUS (curl|wget piped to shell): ${PIPE_EXEC:-none}"
echo "  noisy (eval/base64/atob — usually benign): $([ -n "$NOISY" ] && echo "$(echo "$NOISY" | wc -l | tr -d ' ') hits" || echo none)"

# --- 3. Trivy: CVEs + secrets ---
echo; echo "### 3. Trivy — CVEs + leaked secrets ###"
set +e
docker run --rm -v "$REPO":/scan:ro "$TRIVY" fs --scanners vuln,secret --severity HIGH,CRITICAL --exit-code 1 /scan | tee "$OUT/trivy"
TRIVY_RC=${PIPESTATUS[0]}
set -e

# --- 4. GuardDog: malicious deps ---
echo; echo "### 4. GuardDog — malicious dependency detection ###"
if [ -f "$REPO/package.json" ]; then
  docker run --rm -v "$REPO":/scan:ro "$GUARDDOG" npm verify /scan/package.json 2>&1 | tee "$OUT/guarddog" | tail -40
elif [ -f "$REPO/requirements.txt" ]; then
  docker run --rm -v "$REPO":/scan:ro "$GUARDDOG" pypi verify /scan/requirements.txt 2>&1 | tee "$OUT/guarddog" | tail -40
else
  echo "  (no package.json / requirements.txt — skipped)"; : > "$OUT/guarddog"
fi

if [ "$DEEP" = "--deep" ] && [ -f "$REPO/package.json" ]; then
  echo; echo "### 5. DEEP scan (network ON to fetch tarballs — use a trusted network) ###"
  docker run --rm -v "$REPO":/repo -w /repo --user node --cap-drop=ALL --security-opt=no-new-privileges "$NODE" \
    sh -c '[ -f package-lock.json ] && npm ci --ignore-scripts --no-audit --no-fund || npm install --ignore-scripts --no-audit --no-fund' 2>&1 | tail -5
  docker run --rm -v "$REPO":/scan:ro "$GUARDDOG" npm scan /scan/node_modules 2>&1 | tee -a "$OUT/guarddog" | tail -20 || true
fi

# ---------------- VERDICT ----------------
# Honest design: only HIGH-PRECISION signals alarm (low false-positive rate).
# Heuristic scanners (GuardDog/Trivy) can't reliably tell benign from malicious
# — e.g. ffmpeg-static legitimately "downloads and executes" a binary, which is
# indistinguishable from malware doing the same. So their output is INFO to
# eyeball, never an auto-DANGER. The one thing we alarm on is a repo's OWN source
# piping a remote script into a shell — that is almost never legitimate.
REASONS=(); VERDICT="CLEAN"
if [ -n "$PIPE_EXEC" ]; then VERDICT="DANGER"; REASONS+=("this repo's own source pipes a remote script into a shell (curl|wget → sh)"); fi

# packages GuardDog rated High/Suspicious — for you to eyeball, not an auto-verdict
GD_FLAGGED="$(grep -iE 'Scanning .+, found [0-9]+ risk' "$OUT/guarddog" 2>/dev/null | sed -E 's/.*Scanning (.+), found.*/\1/' | paste -sd', ' - || true)"

INFO=()
[ -n "$GD_FLAGGED" ] && INFO+=("GuardDog raised risk on: $GD_FLAGGED — usually bundled binaries / native installers (fine if you recognise them; investigate if you don't)")
[ "$TRIVY_RC" -ne 0 ] && INFO+=("Trivy: vulnerable/outdated deps or possible secrets (§3 — update deps; rotate any real secret)")
[ -n "$HOOKS" ] && INFO+=("install/build hooks present — normal for apps with native build steps")
[ -n "$NOISY" ] && INFO+=("eval/base64/child_process usage — extremely common, rarely malicious")

echo; echo "==================== VERDICT ===================="
case "$VERDICT" in
  CLEAN)  echo "  ✅ NO HIGH-CONFIDENCE MALWARE SIGNALS.";
          echo "     vet is a filter, not proof — it cannot certify a complex app safe.";
          echo "     Recognise the project + nothing below alarms you  → fine to build & use.";
          echo "     Don't recognise it / anything looks off            → skim the source, or: sandbox $REPO";;
  DANGER) echo "  ⛔ DANGER — high-confidence malicious indicator. Do NOT run this natively:";
          for r in "${REASONS[@]}"; do echo "       • $r"; done
          echo "     Inspect only in:  sandbox $REPO";;
esac
if [ "${#INFO[@]}" -gt 0 ]; then
  echo "  ── things to eyeball (usually normal, NOT proof of malware) ──"
  for i in "${INFO[@]}"; do echo "       · $i"; done
fi
echo "================================================="
echo "source: $REPO"
